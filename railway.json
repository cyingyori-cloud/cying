{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPkgs": ["nodejs_20"],
    "installCommand": "cd api && npm install"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "directory": "api",
    "healthcheckPath": "/api/health",
    "healthcheckPort": 3001
  }
}
